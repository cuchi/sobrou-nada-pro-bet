# ── Database ──────────────────────────────────────────
DATABASE_URL=postgres://snpb:snpb@localhost:5432/snpb

# ── Auth ──────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# Generate with: openssl rand -base64 32
ADMIN_TOKEN=change-me-to-another-random-secret

# ── Integrations ──────────────────────────────────────
ODDS_API_KEY=your-key-from-the-odds-api.com

# Mailgun (outbound email — bet resolved + new events digest).
# Optional in dev: when both unset, sends log + skip. Required in production.
# Get an API key from https://app.mailgun.com → Settings → API Keys.
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com

# Sender address used on outgoing emails. Must live on the verified
# Mailgun domain above, otherwise production sends bounce. The default
# noreply@sobrou-nada.local is fine for dev only.
# MAILGUN_FROM=noreply@yourdomain.com

# ── Environment ───────────────────────────────────────
# "development" (default) or "production"
# ENVIRONMENT=development

# Comma-separated origins allowed by CORS.
# Leave empty in dev (all origins allowed with a warning in prod).
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Server ────────────────────────────────────────────
# PORT=3000

# ── Logging ───────────────────────────────────────────
# Optional. Defaults: debug in dev, info in prod.
# RUST_LOG=sobrou_nada_pro_bet=debug,tower_http=debug
